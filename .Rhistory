library(usethis)
library(devtools)
devtools::load_all()
library(HessR)
?hess_run
# Combustion du methane
ex <- hess_example("methane")
res <- hess_run(ex$reactions, show_diagram = TRUE)
# Les coefficients sont trouves automatiquement a partir de la cible
ex <- hess_example("formation_methane")
res <- hess_run(ex$reactions, target = ex$target, show_diagram = TRUE)
res$delta_h
hess_run(ex$reactions, target = ex$target)
library(HessR)
library(usethis)
library(devtools)
devtools::load_all()
library(HessR)
?hess_calculate
?hess_check_balance
